    <script>\
        const canvas = document.getElementById('gameCanvas');\
        const ctx = canvas.getContext('2d');\
        const wheel = document.getElementById('steering-wheel');\
\
        function resizeCanvas() \{\
            canvas.width = canvas.clientWidth;\
            canvas.height = canvas.clientHeight;\
        \}\
        window.addEventListener('load', resizeCanvas);\
        window.addEventListener('resize', resizeCanvas);\
        resizeCanvas();\
\
        // Mechanical Settings Variables\
        let playerX = 0; \
        let score = 0;\
        let speed = 20; \
        let baseSpeed = 40;\
        let currentTargetSpeed = 40;\
        let gameOver = false;\
        let roadTracker = 0;\
\
        let obstacles = [];\
        let spawnTimer = 0;\
\
        // Hardware Controls Variables\
        let isDrawing = false;\
        let startAngle = 0;\
        let currentRotation = 0;\
        let basePitch = null; \
        let currentPitch = 0;\
\
        function initSensors() \{\
            if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') \{\
                DeviceOrientationEvent.requestPermission()\
                    .then(response => \{\
                        if (response == 'granted') \{\
                            window.addEventListener('deviceorientation', handleMotion);\
                            document.getElementById('start-overlay').style.display = 'none';\
                        \}\
                    \})\
                    .catch(console.error);\
            \} else \{\
                window.addEventListener('deviceorientation', handleMotion);\
                document.getElementById('start-overlay').style.display = 'none';\
            \}\
        \}\
\
        function handleMotion(event) \{\
            let pitch = event.beta; \
            if (basePitch === null && pitch !== null) basePitch = pitch; \
            currentPitch = pitch - basePitch;\
            document.getElementById('tilt-val').textContent = Math.floor(currentPitch) + '\'b0';\
\
            // Lean forward triggers linear target speed increase up to 160 MPH max\
            if (currentPitch > 6) \{ \
                currentTargetSpeed = Math.min(160, baseSpeed + (currentPitch - 6) * 5);\
            \} else if (currentPitch < -6) \{ \
                // Lean backward forces heavy mechanical drop down to 10 MPH minimum brake speeds\
                currentTargetSpeed = Math.max(10, baseSpeed + (currentPitch + 6) * 4.5);\
            \} else \{\
                currentTargetSpeed = baseSpeed;\
            \}\
        \}\
\
        function getAngle(e) \{\
            const rect = wheel.getBoundingClientRect();\
            const center = \{ x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 \};\
            const clientX = e.touches ? e.touches.clientX : e.clientX;\
            const clientY = e.touches ? e.touches.clientY : e.clientY;\
            return Math.atan2(clientY - center.y, clientX - center.x);\
        \}\
\
        wheel.addEventListener('touchstart', (e) => \{\
            isDrawing = true;\
            startAngle = getAngle(e) - currentRotation;\
